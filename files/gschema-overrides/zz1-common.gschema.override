[org.gnome.shell.extensions.chromaleon]
accent-color='#347ee5'
create-shortcut=false
custom-color=true
custom-css=false
darker=true
full-light=false
gnome-colors=false
hot-reload=1
last-error=''
morewaita=false
persistent-choices=true
prefer-light=false
recolor-apps=false
recolor-folders=false
tint-apps=true
tint-gtk3=true
tint-panel=true
tint-shell=true
tinting-strength=1
user-themes-warning=false
