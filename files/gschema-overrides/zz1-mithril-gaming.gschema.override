[org.gnome.desktop.wm.preferences]
num-workspaces=3
button-layout='appmenu:minimize,maximize,close'

[org.gnome.shell]
enabled-extensions=['blur-my-shell@aunetx', 'caffeine@patapon.info', 'compiz-windows-effect@hermes83.github.com', 'dash-to-panel@jderose9.github.com', 'just-perfection-desktop@just-perfection', 'arcmenu@arcmenu.com', 'auto-move-windows@gnome-shell-extensions.gcampax.github.com', 'user-accent-colors@fabito02']
favorite-apps=['org.Gnome.Nautilus.desktop', 'org.mozilla.firefox.desktop', 'com.toolstack.Folio.desktop', 'org.fooyin.fooyin.desktop', 'steam.desktop', 'com.heroicgameslauncher.hgl.desktop']

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/monterey/monterey-dark-purple.png'
picture-uri-dark='file:///usr/share/backgrounds/monterey/monterey-dark-purple.png'

[org.gnome.shell.extensions.auto-move-windows]
application-list=['org.gnome.Nautilus.desktop:1', 'org.mozilla.firefox.desktop:1', 'com.toolstack.Folio.desktop:1', 'org.fooyin.fooyin.desktop:2', 'steam.desktop:3', 'com.heroicgameslauncher.hgl.desktop:3']

[org.gnome.shell.extensions.caffeine]
cli-toggle=true
countdown-timer=0
duration-timer=2
duration-timer-list=[900, 1800, 3600]
enable-fullscreen=true
enable-mpris=false
indicator-position=0
indicator-position-index=0
indicator-position-max=1
inhibit-apps=@as []
nightlight-control='never'
prefs-default-height=590
prefs-default-width=570
restore-state=false
screen-blank='never'
show-indicator='only-active'
show-notifications=true
show-timer=true
show-toggle=true
toggle-shortcut=@as []
trigger-apps-mode='on-running'
use-custom-duration=false
user-enabled=false

[org.gnome.shell.extensions.chromaleon]
accent-color='#3c0c6c'
create-shortcut=false
custom-color=true
custom-css=false
darker=true
full-light=false
gnome-colors=false
hot-reload=1
last-error=''
morewaita=false
persistent-choices=true
prefer-light=false
recolor-apps=false
recolor-folders=false
tint-apps=true
tint-gtk3=true
tint-panel=true
tint-shell=true
tinting-strength=1
user-themes-warning=false
