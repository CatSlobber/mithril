[org.gnome.desktop.wm.preferences]
num-workspaces=2
button-layout='appmenu:minimize,maximize,close'

[org.gnome.shell]
enabled-extensions=['blur-my-shell@aunetx', 'compiz-windows-effect@hermes83.github.com', 'dash-to-panel@jderose9.github.com', 'just-perfection-desktop@just-perfection', 'arcmenu@arcmenu.com', 'auto-move-windows@gnome-shell-extensions.gcampax.github.com', 'user-accent-colors@fabito02']
favorite-apps=['org.Gnome.Nautilus.desktop', 'org.mozilla.firefox.desktop', 'com.toolstack.Folio.desktop', 'org.fooyin.fooyin.desktop']

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/monterey/monterey-dark-blue.png'
picture-uri-dark='file:///usr/share/backgrounds/monterey/monterey-dark-blue.png'

[org.gnome.shell.extensions.auto-move-windows]
application-list=['org.gnome.Nautilus.desktop:1', 'org.mozilla.firefox.desktop:1', 'com.toolstack.Folio.desktop:1', 'org.fooyin.fooyin.desktop:2']

[org.gnome.shell.extensions.chromaleon]
accent-color='#347ee5'
create-shortcut=false
custom-color=true
custom-css=false
darker=true
full-light=false
gnome-colors=false
hot-reload=1
last-error=''
morewaita=false
persistent-choices=true
prefer-light=false
recolor-apps=false
recolor-folders=false
tint-apps=true
tint-gtk3=true
tint-panel=true
tint-shell=true
tinting-strength=1
user-themes-warning=false
